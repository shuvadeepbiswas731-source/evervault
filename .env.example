# Copy these placeholders into a private .env file. Never commit .env.
# The Windows launcher loads its private .env; Render uses dashboard environment variables.

DATABASE_URL=replace-with-your-Neon-connection-string

# Session secret placeholder. Keep the real value private.
EVERVAULT_SECRET=replace-with-a-long-random-session-secret

# Keep the actual Google Drive OAuth token JSON private.
GOOGLE_DRIVE_TOKEN_JSON=replace-with-the-complete-authorized-user-token-json

# Tunnel disabled by default. Enable explicitly in Render after configuration.
EVERVAULT_TUNNEL_ENABLED=0

# Leave blank when using the built-in Evervault tunnel.
LOCAL_STORAGE_URL=

# Placeholder only. Configure the actual token in Render's dashboard.
LOCAL_STORAGE_TOKEN=replace-with-the-token-from-D-EvervaultState-storage_agent.token