# Copy the required values into your local private .env file or deployment environment.
# Do not use these placeholders as real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
EVERVAULT_SECRET=replace-with-a-long-random-secret
# Set this in Render as a complete JSON string. Keep real token JSON private.
GOOGLE_DRIVE_TOKEN_JSON={"token":"REPLACE_ME","refresh_token":"REPLACE_ME"}
