# Copy the required settings into a private .env file. Never commit .env.
# The Windows launcher explicitly loads this private file; Render uses its dashboard secrets.
DATABASE_URL=replace-with-your-Neon-connection-string

# Render-only settings for Evervault's built-in reverse tunnel
EVERVAULT_SECRET=replace-with-a-long-random-session-secret
GOOGLE_DRIVE_TOKEN_JSON=replace-with-the-complete-authorized-user-token-json

EVERVAULT_TUNNEL_ENABLED=0
# Leave blank when using the built-in tunnel.
LOCAL_STORAGE_URL=
# Placeholder only: set the real token in Render's dashboard.
LOCAL_STORAGE_TOKEN=replace-with-the-token-from-D-EvervaultState-storage_agent.token
